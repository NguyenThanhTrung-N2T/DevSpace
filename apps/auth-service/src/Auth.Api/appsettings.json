{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=devspace;Username=devspace;Password=dummy_pwd;SearchPath=auth"
  },
  "Jwt": {
    "Issuer": "devspace-auth",
    "Audience": "devspace-apps",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "PrivateKey": "",
    "PublicKey": "",
    "KeyId": "devspace-key-v1"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost"
    ]
  },
  "RateLimit": {
    "LoginPermitLimit": 5,
    "LoginQueueLimit": 0,
    "RegisterPermitLimit": 3,
    "RegisterQueueLimit": 0
  },
  "Security": {
    "PublicOrigin": "https://localhost:5001",
    "PasswordMinLength": 8,
    "PasswordRequireUppercase": true,
    "PasswordRequireLowercase": true,
    "PasswordRequireDigit": true,
    "PasswordRequireNonAlphanumeric": false,
    "PasswordResetExpiryMinutes": 30,
    "EmailVerificationExpiryHours": 24
  }
}
