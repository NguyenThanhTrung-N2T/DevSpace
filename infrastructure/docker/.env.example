# DevSpace Environment Variables
# Copy this file to .env and customize as needed.

# Neon/PostgreSQL Cloud Connection String
# Example: Host=ep-xyz-123.us-east-2.aws.neon.tech;Database=devspace;Username=devspace_owner;Password=xyz;SSL Mode=Require;Trust Server Certificate=true;SearchPath=auth
DATABASE_URL=your_neon_connection_string_here

# JWT Keys (Base64 encoded RS256 key pair)
# Generate with: openssl genrsa -out private.pem 2048
#                openssl rsa -in private.pem -pubout -out public.pem
# Then base64 encode without newlines: cat private.pem | base64 -w 0
JWT_PRIVATE_KEY=your_base64_encoded_private_key_here
JWT_PUBLIC_KEY=your_base64_encoded_public_key_here

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost,https://devspace.app
